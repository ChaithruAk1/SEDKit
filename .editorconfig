root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
max_line_length = 120

[*.py]
indent_size = 4

[*.{ts,tsx,js,mjs,jsx,css,json,yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf

[{Makefile,*.mk}]
indent_style = tab
