{
  "name": "sed-web",
  "private": true,
  "version": "0.2.0",
  "description": "SED local dashboard (served by `sed serve` from web/dist; typed against contracts/openapi.json)",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "vite --mode fixtures",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "vite build",
    "gen:api": "openapi-typescript ../contracts/openapi.json -o src/api/schema.d.ts",
    "gen:api:check": "openapi-typescript ../contracts/openapi.json -o src/api/schema.d.ts --check",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@tabler/icons-react": "3.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
