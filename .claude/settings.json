{
  "env": {
    "UV_NO_SYNC": "1",
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "allow": [
      "Bash(uv run sed:*)",
      "PowerShell(uv run sed:*)",
      "Read(./.claude/skills/**)"
    ],
    "ask": [
      "Bash(uv run sed review:*)",
      "PowerShell(uv run sed review:*)",
      "Bash(uv run sed mappings save-override:*)",
      "PowerShell(uv run sed mappings save-override:*)",
      "Bash(uv run sed config save-override:*)",
      "PowerShell(uv run sed config save-override:*)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python -c \"import os,runpy,sys;h=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or os.getcwd(),'.claude/hooks/guard_data_dir.py');sys.exit(runpy.run_path(h,run_name='__main__') if os.path.isfile(h) else 0)\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
