{
  "env": {
    "UV_NO_SYNC": "1",
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "allow": [
      "Bash(uv run sed:*)",
      "PowerShell(uv run sed:*)",
      "Read(./.claude/skills/**)"
    ],
    "ask": [
      "Bash(uv run sed review:*)",
      "PowerShell(uv run sed review:*)",
      "Bash(uv run sed mappings save-override:*)",
      "PowerShell(uv run sed mappings save-override:*)",
      "Bash(uv run sed config save-override:*)",
      "PowerShell(uv run sed config save-override:*)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch"
    ]
  }
}
